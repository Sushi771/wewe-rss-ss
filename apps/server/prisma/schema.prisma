// Independent 20-model union candidate; does not replace migration histories.
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model XhsSubscriptionTask {
  id String @id
  creatorId String @map("creator_id")
  state String
  document String
  updatedAt BigInt @map("updated_at")

  @@index([creatorId, state])
  @@map("xhs_subscription_tasks")
}

model Account {
  id        String    @id
  token     String    @map("token")
  name      String    @map("name")
  status    Int       @default(1) @map("status")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")

  @@map("accounts")
}

model CacheInsertBatch {
  id String @id
  mpId String @map("mp_id")
  articleManifest String @map("article_manifest")
  snapshotGeneration String @map("snapshot_generation")
  guardGeneration String @map("guard_generation")
  backupStartedAtMs BigInt @map("backup_started_at_ms")
  coverageAtMs BigInt @map("coverage_at_ms")
  createdCount Int @map("created_count")
  committedAtMs BigInt @map("committed_at_ms")

  @@map("cache_insert_batches")
}

model CacheRefreshCommit {
  id String @id
  mpId String @map("mp_id")
  resultJson String @map("result_json")
  committedAtMs BigInt @map("committed_at_ms")

  @@index([mpId])
  @@map("cache_refresh_commits")
}

model RefreshSubmissionClaim {
  id String @id
  mpId String @map("mp_id")
  state String
  reservedAt Int @map("reserved_at")
  previousAt Int @map("previous_at")
  updatedAtMs BigInt @map("updated_at_ms")

  @@map("refresh_submission_claims")
}

model Feed {
  id         String    @id
  mpName     String    @map("mp_name")
  mpCover    String    @map("mp_cover")
  mpIntro    String    @map("mp_intro")
  status     Int       @default(1) @map("status")
  syncTime   Int       @default(0) @map("sync_time")
  updateTime Int       @map("update_time")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at")
  hasHistory Int?      @default(1) @map("has_history")
  order      Int       @default(0) @map("order")
  localDirectory String? @map("local_directory")
  publicAlbumIds String? @map("public_album_ids")
  lastCollectionResult String? @map("last_collection_result")
  collectionChannel String? @map("collection_channel")
  providerRefreshAttemptTime Int @default(0) @map("provider_refresh_attempt_time")
  groupId    String? @map("group_id")
  group      ManagementGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  articles   Article[]

  @@index([groupId])
  @@map("feeds")
}

model Article {
  id          String    @id
  mpId        String    @map("mp_id")
  title       String    @map("title")
  picUrl      String    @map("pic_url")
  publishTime Int       @map("publish_time")
  sourceUrl   String?   @unique @map("source_url")
  contentHtml String?   @map("content_html")
  lastBodyStatus String? @map("last_body_status")
  verifiedSourceUrl String? @map("verified_source_url")
  lastBodyRetry String? @map("last_body_retry")
  metrics     String?   @map("metrics")
  readCount   Int?      @map("read_count")
  likeCount   Int?      @map("like_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at")
  feed        Feed      @relation(fields: [mpId], references: [id], onDelete: Cascade)
  searchDocument ArticleSearchDocument?

  @@index([mpId])
  @@index([publishTime, id])
  @@map("articles")
}

model XhsCreator {
  id               String    @id @default(cuid())
  profileUrl       String    @unique @map("profile_url")
  displayName      String    @map("display_name")
  externalAuthorId String?   @unique @map("external_author_id")
  enabled          Boolean   @default(true)
  lastStatus       String    @default("pending") @map("last_status")
  lastCheckedAt    Int       @default(0) @map("last_checked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  groupId          String?   @map("group_id")
  group            ManagementGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  notes            XhsNote[]
  refreshJobs      XhsRefreshJob[]
  refreshBatchItems XhsRefreshBatchItem[]

  @@index([groupId])
  @@map("xhs_creators")
}

model ManagementGroup {
  id       String       @id @default(cuid())
  name     String
  platform String
  order    Int          @default(0)
  feeds    Feed[]
  creators XhsCreator[]

  @@index([platform])
  @@map("management_groups")
}

model XhsNote {
  id          String     @id
  creatorId   String     @map("creator_id")
  title       String
  publishTime Int        @map("publish_time")
  status      String
  contentHtml String?    @map("content_html")
  kind        String?
  videoBytes  Bytes?     @map("video_bytes")
  videoMimeType String?  @map("video_mime_type")
  videoExpectedBytes Int? @map("video_expected_bytes")
  videoSha256 String?   @map("video_sha256")
  creator     XhsCreator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  savedComments XhsSavedComment[]
  commentWindows XhsCommentWindow[]

  @@index([creatorId, publishTime])
  @@map("xhs_notes")
}

model XhsMetricSnapshot {
  ownerKind String @map("owner_kind")
  ownerId String @map("owner_id")
  document String

  @@id([ownerKind, ownerId])
  @@map("xhs_metric_snapshots")
}

model XhsSavedComment {
  noteId String @map("note_id")
  commentId String @map("comment_id")
  rootId String? @map("root_id")
  parentId String? @map("parent_id")
  document String
  note XhsNote @relation(fields: [noteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([noteId, commentId])
  @@index([noteId, rootId, commentId], map: "xhs_saved_comments_root")
  @@map("xhs_saved_comments")
}

model XhsCommentWindow {
  noteId String @map("note_id")
  scope String
  document String
  note XhsNote @relation(fields: [noteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([noteId, scope])
  @@map("xhs_comment_windows")
}

model ArticleSearchDocument {
  articleId String @id @map("article_id")
  bodyText String @default("") @map("body_text")
  bodyCached Boolean @default(false) @map("body_cached")
  pending Boolean @default(true)
  generation Int @default(0)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([pending,articleId], map:"article_search_pending_idx")
  @@index([bodyCached], map:"article_search_cached_idx")
  @@map("article_search_documents")
}

model ArticleFailureEvent {
  attemptId  String @map("attempt_id")
  feedId     String @map("feed_id")
  articleId  String @map("article_id")
  stage      String
  code       String
  observedAt BigInt @map("observed_at")

  @@id([attemptId, articleId, stage])
  @@index([feedId, articleId])
  @@map("article_failure_events")
}

model XhsRefreshJob {
  creatorId  String @map("creator_id")
  generation Int
  owner      String @unique(map: "xhs_refresh_operation_id")
  startedAt  BigInt @map("started_at")
  state      String
  outcome    String?
  creator    XhsCreator @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@id([creatorId, generation])
  @@map("xhs_refresh_jobs")
}

model XhsRefreshFailure {
  creatorId  String @map("creator_id")
  generation Int
  noteId     String @map("note_id")
  code       String

  @@id([creatorId, generation, noteId])
  @@map("xhs_refresh_failures")
}

model XhsRefreshBatch {
  id String @id
  state String
  createdAt BigInt @map("created_at")
  items XhsRefreshBatchItem[]

  @@map("xhs_refresh_batches")
}

model XhsRefreshBatchItem {
  batchId String @map("batch_id")
  position Int
  creatorId String @map("creator_id")
  operationId String? @unique @map("operation_id")
  state String
  outcome String?
  batch XhsRefreshBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  creator XhsCreator @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@id([batchId, position])
  @@unique([batchId, creatorId])
  @@map("xhs_refresh_batch_items")
}

model Wechat2RssSourceGate {
  id     Int     @id
  state  String
  token  String?
  status Int?


}
