# Copy to .env.private-online on the server; chmod 600. Never commit the filled file.
AUTH_CODE=
PRIVATE_UPSTREAM_TOKEN=
LIC_EMAIL=
LIC_CODE=
SERVER_ORIGIN_URL=https://your-server.your-tailnet.ts.net
# Keep disabled until the real upstream and SQLite copy pass acceptance.
WECHAT2RSS_ENABLED=0
CRON_EXPRESSION=35 5,17 * * *
# Optional candidate view/scan. Bind one feed and a writable absolute private JSON path.
# Scanning also requires OWNER_SEARCH_CONFIG_FILE with a valid normal Web session.
# Leave both unset to hide the candidate snapshot section. Do not point at immutable evidence.
OWNER_SEARCH_CANDIDATE_FEED_ID=
OWNER_SEARCH_CANDIDATE_SNAPSHOT_FILE=
